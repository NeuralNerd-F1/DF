{
  "openapi": "3.1.0",
  "info": {
    "title": "APEX API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Get Health",
        "description": "Report DB + model-handle status. Critical = DB connected AND every model ready; cache\n(Redis, F14) is reported but never critical. Any critical failure → HTTP 503.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "predict"
        ],
        "summary": "Post Predict",
        "operationId": "post_predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/segments": {
      "get": {
        "tags": [
          "predict"
        ],
        "summary": "List Segments",
        "description": "The curated held-out sample laps for the Prediction screen. 200 with [] when the profiles\nartefact is absent — the screen then explains there is nothing to pick, exactly like an empty\ndriver grid; a missing *demo* source is not a service failure.",
        "operationId": "list_segments_segments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SampleSegmentSchema"
                  },
                  "type": "array",
                  "title": "Response List Segments Segments Get"
                }
              }
            }
          }
        }
      }
    },
    "/drivers": {
      "get": {
        "tags": [
          "drivers"
        ],
        "summary": "List Drivers",
        "description": "200 always — an empty array if the fingerprints table is empty (§8.5). Deterministic: each\ndriver's radar is its LATEST (season, circuit) row, matching /fingerprint and /compare (§11).\n\nThe DB supplies identity + radar; the startup-loaded profiles artefact supplies the lap counts,\nlap-time consistency and per-driver held-out F1. The two are independent — an absent artefact\nleaves ``profile`` null and ``signature`` empty without touching the rest of the row, so this\nendpoint never fails because a *supplementary* source is missing.",
        "operationId": "list_drivers_drivers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DriverSummary"
                  },
                  "type": "array",
                  "title": "Response List Drivers Drivers Get"
                }
              }
            }
          }
        }
      }
    },
    "/drivers/{driver_id}/fingerprint": {
      "get": {
        "tags": [
          "drivers"
        ],
        "summary": "Driver Fingerprint",
        "operationId": "driver_fingerprint_drivers__driver_id__fingerprint_get",
        "parameters": [
          {
            "name": "driver_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Driver Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FingerprintResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/drivers/{driver_id}/setup/{circuit_id}": {
      "get": {
        "tags": [
          "drivers"
        ],
        "summary": "Driver Setup",
        "operationId": "driver_setup_drivers__driver_id__setup__circuit_id__get",
        "parameters": [
          {
            "name": "driver_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Driver Id"
            }
          },
          {
            "name": "circuit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Circuit Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tyres": {
      "get": {
        "tags": [
          "drivers"
        ],
        "summary": "Tyre Wear",
        "description": "Per-driver, per-compound stint degradation (Screen 4). Served from the startup-loaded\nprofiles artefact; absent artefact → an empty map, never fabricated curves. A malformed\nper-compound block is skipped WITH a data_quality_log row — a screen fed by this endpoint\ncan trust every curve it does receive.",
        "operationId": "tyre_wear_tyres_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TyreWearResponse"
                }
              }
            }
          }
        }
      }
    },
    "/compare/{id1}/{id2}": {
      "get": {
        "tags": [
          "style"
        ],
        "summary": "Compare",
        "operationId": "compare_compare__id1___id2__get",
        "parameters": [
          {
            "name": "id1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id1"
            }
          },
          {
            "name": "id2",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id2"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/stylespace": {
      "get": {
        "tags": [
          "style"
        ],
        "summary": "Stylespace",
        "operationId": "stylespace_stylespace_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StyleSpaceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/replay/{session_id}/{driver_id}": {
      "get": {
        "tags": [
          "replay"
        ],
        "summary": "Replay",
        "description": "Replay a persisted stint through the degradation detector (§10.7). 200 full · 206 partial ·\n404 unknown.",
        "operationId": "replay_replay__session_id___driver_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "driver_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Driver Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "tags": [
          "replay"
        ],
        "summary": "Sessions",
        "description": "List persisted sessions with their replayable drivers (newest season/round first).",
        "operationId": "sessions_sessions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  },
                  "type": "array",
                  "title": "Response Sessions Sessions Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompareResponse": {
        "properties": {
          "driver_1_radar": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Driver 1 Radar"
          },
          "driver_2_radar": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Driver 2 Radar"
          },
          "delta_shap": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Delta Shap"
          },
          "most_distinctive_features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Most Distinctive Features"
          },
          "compatibility_delta": {
            "type": "number",
            "title": "Compatibility Delta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "driver_1_radar",
          "driver_2_radar",
          "delta_shap",
          "most_distinctive_features",
          "compatibility_delta"
        ],
        "title": "CompareResponse"
      },
      "ConfidenceBreakdownSchema": {
        "properties": {
          "feature_quality": {
            "type": "number",
            "title": "Feature Quality"
          },
          "distribution": {
            "type": "number",
            "title": "Distribution"
          },
          "model_confidence": {
            "type": "number",
            "title": "Model Confidence"
          },
          "overall": {
            "type": "number",
            "title": "Overall"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature_quality",
          "distribution",
          "model_confidence",
          "overall"
        ],
        "title": "ConfidenceBreakdownSchema",
        "description": "The propagated-confidence composition (system input #6). Mirrors\n``app.ml.inference.ConfidenceBreakdown`` field-for-field: three served signals (distance from\nthe NULL ceiling, distance from the AMBIGUOUS entropy boundary, calibrated max-probability) and\ntheir product. Presentational — the gate's ``confidence_state`` stays authoritative."
      },
      "ConfidenceState": {
        "type": "string",
        "enum": [
          "HIGH",
          "MEDIUM",
          "LOW_CONFIDENCE",
          "AMBIGUOUS",
          "OUT_OF_DISTRIBUTION"
        ],
        "title": "ConfidenceState",
        "description": "Explicit confidence / uncertainty state for a classifier prediction.\n\nMirrors the ``predictions.confidence_state`` column (master spec §8.4) and adds\n``OUT_OF_DISTRIBUTION`` — the style-space state (§5.2) that the project\nconstitution lists as a mandatory uncertainty state (non-negotiable #4). The\nclassifier never returns a forced label below the confidence gate; it returns\none of these states instead."
      },
      "DriverProfileSchema": {
        "properties": {
          "laps_analysed": {
            "type": "integer",
            "title": "Laps Analysed"
          },
          "seasons": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Seasons"
          },
          "n_circuits": {
            "type": "integer",
            "title": "N Circuits",
            "default": 0
          },
          "lap_time_consistency_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lap Time Consistency S"
          },
          "identification_f1": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Identification F1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "laps_analysed"
        ],
        "title": "DriverProfileSchema",
        "description": "Dataset + evaluation facts for one driver, sourced from ``driver_profiles.json``.\n\nEvery optional field is ``None`` for an honest \"not measured\", never 0.0: a driver with too few\nlaps for a within-session SD and a driver who laps identically every time must not render the\nsame. ``identification_f1`` is the champion's **held-out** per-driver F1 — a driver the summary\nnever scored keeps ``None`` rather than borrowing a training-split number."
      },
      "DriverSignalSchema": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature"
          },
          "attribution": {
            "type": "number",
            "title": "Attribution"
          },
          "percentile": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percentile"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature",
          "attribution"
        ],
        "title": "DriverSignalSchema",
        "description": "One feature the champion attributes most to a driver, plus where they rank on it.\n\n``attribution`` is mean |SHAP| — a magnitude, so it never implies a direction. ``percentile`` is\nthe driver's rank on that feature against the rest of the grid (0 = lowest mean, 1 = highest)\nand is ``None`` when the profiles artefact carries no rank, so the screen names the feature\nwithout claiming which way it points."
      },
      "DriverSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "team": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name"
          },
          "radar_values": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Radar Values"
          },
          "signature": {
            "items": {
              "$ref": "#/components/schemas/DriverSignalSchema"
            },
            "type": "array",
            "title": "Signature"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DriverProfileSchema"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "code"
        ],
        "title": "DriverSummary"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "OK",
          "CONFIG_001",
          "DATA_QUALITY_LOG_UNWRITABLE",
          "DATA_001",
          "STALE_DATA",
          "DATA_SOURCE_UNAVAILABLE",
          "COMPOUND_UNKNOWN",
          "COMPOUND_FALLBACK",
          "DERIVED_AGE",
          "CACHE_CORRUPT",
          "TRACK_STATUS_UNAVAILABLE",
          "LAP_001",
          "LAP_002",
          "LAP_003",
          "LAP_INTERP",
          "LAP_004",
          "LAP_005",
          "LAP_006",
          "LAP_PARTIAL",
          "COMBO_001",
          "DATA_INSUFFICIENT",
          "ORPHAN_SAMPLES",
          "VALIDATION_ERROR",
          "FEATURE_001",
          "LAP_NULL_EXCESS",
          "IMPUTED",
          "CORNER_001",
          "LOW_CONFIDENCE",
          "AMBIGUOUS",
          "MODEL_NOT_FOUND",
          "INVALID_INPUT",
          "PERF_WARN",
          "INFERENCE_ERROR",
          "TRAIN_LEAKAGE",
          "MODEL_TRAINING_FAILED",
          "SPARSE_PROJECTION",
          "OUT_OF_DISTRIBUTION",
          "UMAP_FALLBACK",
          "PROJECTION_FALLBACK",
          "MONITOR_INACTIVE",
          "BASELINE_INSUFFICIENT",
          "FALLBACK_THRESHOLD",
          "DEGRADED_QUALITY",
          "DISTANCE_NAN",
          "MONITOR_ERROR",
          "SHAP_UNAVAILABLE",
          "SHAP_CONSISTENCY_WARN",
          "CONSTRAINT_CLIPPED",
          "CONSISTENCY_WARNING",
          "CIRCUIT_OVERRIDE_MONACO",
          "WIDE_CONFIDENCE",
          "NORMALISATION_FALLBACK",
          "CACHE_MISS",
          "CACHE_UNAVAILABLE",
          "CACHE_DEGRADED",
          "REPLAY_PARTIAL",
          "DB_UNAVAILABLE",
          "HEALTH_FAIL",
          "NOT_FOUND",
          "FORBIDDEN",
          "API_ERROR"
        ],
        "title": "ErrorCode",
        "description": "Every named error code, flag, fallback, and warning in the APEX spec."
      },
      "FingerprintResponse": {
        "properties": {
          "driver_id": {
            "type": "string",
            "title": "Driver Id"
          },
          "vector_5d": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Vector 5D"
          },
          "shap_radar": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Shap Radar"
          },
          "nl_description": {
            "type": "string",
            "title": "Nl Description",
            "default": ""
          },
          "stability": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StabilityResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "shap_signed": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Shap Signed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "driver_id",
          "vector_5d"
        ],
        "title": "FingerprintResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "title": "Status"
          },
          "models_loaded": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Models Loaded"
          },
          "db_connected": {
            "type": "boolean",
            "title": "Db Connected"
          },
          "cache_connected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cache Connected"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "models_loaded",
          "db_connected",
          "version"
        ],
        "title": "HealthResponse"
      },
      "PredictRequest": {
        "properties": {
          "feature_vector": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Feature Vector"
          },
          "circuit": {
            "type": "string",
            "title": "Circuit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature_vector",
          "circuit"
        ],
        "title": "PredictRequest"
      },
      "PredictResponse": {
        "properties": {
          "predicted_driver": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Driver"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "confidence_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfidenceState"
              },
              {
                "type": "null"
              }
            ]
          },
          "top_3": {
            "items": {
              "$ref": "#/components/schemas/TopK"
            },
            "type": "array",
            "title": "Top 3"
          },
          "class_probabilities": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Class Probabilities"
          },
          "shap_values": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shap Values"
          },
          "shap_available": {
            "type": "boolean",
            "title": "Shap Available",
            "default": false
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "confidence_breakdown": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfidenceBreakdownSchema"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "predicted_driver",
          "confidence",
          "confidence_state",
          "model_version"
        ],
        "title": "PredictResponse"
      },
      "ReplayAlert": {
        "properties": {
          "alert_lap": {
            "type": "integer",
            "title": "Alert Lap"
          },
          "first_crossing_lap": {
            "type": "integer",
            "title": "First Crossing Lap"
          },
          "laps_since_threshold_crossed": {
            "type": "integer",
            "title": "Laps Since Threshold Crossed"
          },
          "deviation_score": {
            "type": "number",
            "title": "Deviation Score"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "alert_confidence": {
            "type": "string",
            "title": "Alert Confidence"
          },
          "feature_attribution": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Feature Attribution"
          },
          "top_features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Top Features"
          },
          "optimal_window_remaining_laps": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Optimal Window Remaining Laps"
          }
        },
        "additionalProperties": false,
        "type": "object",
