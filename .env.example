# APEX environment variables (F12 persistence layer). Copy to `.env` and fill in.
# NEVER commit real secrets. The database DSN is sourced from the environment — config.yaml stores
# only the env-var NAME (database.dsn_env_var), honouring §9 row-level-security / secret hygiene.
#
# Driver: psycopg v3 async (postgresql+psycopg://). The master §9 names asyncpg, but it has no
# Python-3.14 wheel; psycopg v3 is the ratified substitute (see pyproject.toml / ARCHITECTURE.md).

# Async DSN used by the app AND by Alembic migrations (matches docker-compose.yml postgres service).
APEX_DATABASE_URL=postgresql+psycopg://apex:apex@localhost:5432/apex

# Optional. When set, ENABLES the @pytest.mark.postgres migration round-trip / no-drift test against
# a real PostgreSQL. Leave unset to keep the default offline (aiosqlite) test suite.
APEX_TEST_DATABASE_URL=postgresql+psycopg://apex:apex@localhost:5432/apex_test

# --- F14 platform layer (Redis cache). Env-only secret (§9): config.yaml stores only the env-var
# NAME (cache.url_env_var). The cache is an optimisation — with APEX_REDIS_URL unset or unreachable
# the system runs cache-less, every read served from source.

# Redis cache DSN (Upstash in prod). Optional: absent → cache disabled, all reads serve from source.
# Setting it also enables the @pytest.mark.redis integration tests (default suite runs offline).
APEX_REDIS_URL=redis://localhost:6379/0
